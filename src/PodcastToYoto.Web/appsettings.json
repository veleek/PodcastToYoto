{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "PublicBaseUrl": "",
    "DataDirectory": "/data"
  },
  "Yoto": {
    "ClientId": "",
    "Scopes": "user:content:view user:content:manage user:icons:manage offline_access"
  },
  "Notifications": {
    "HomeAssistant": {
      "BaseUrl": "",
      "WebhookId": "",
      "Service": "",
      "Token": "",
      "Events": []
    }
  },
  "Backup": {
    "Enabled": true,
    "Directory": "backups",
    "TimeOfDay": "03:30",
    "Keep": 14
  },
  "Sync": {
    "DefaultPollInterval": "01:00:00",
    "RunOnStartup": true,
    "DryRun": false
  }
}
