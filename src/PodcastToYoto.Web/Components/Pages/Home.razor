@page "/"
@inject YotoAccountService Account
@inject PlaylistService Playlists
@inject TimeProvider Time
@inject SyncScheduler Scheduler
@inject NavigationManager Nav

<PageTitle>Podcast → Yoto</PageTitle>

<h1 class="muted" style="font-size:1.1rem;font-weight:500">Dashboard</h1>

@if (!string.IsNullOrEmpty(AuthError))
{
    <div class="alert">Yoto login failed: @AuthError</div>
}

<section class="card">
    <h2>Yoto account</h2>
    @if (_status is null)
    {
        <p class="muted">Loading…</p>
    }
    else
    {
        <div class="row">
            @switch (_status.Status)
            {
                case AccountStatus.Connected:
                    <span class="badge ok">Connected</span>
                    break;
                case AccountStatus.NeedsReauth:
                    <span class="badge err">Needs re-login</span>
                    break;
                default:
                    <span class="badge none">Not connected</span>
                    break;
            }
            @if (_status.Status != AccountStatus.Disconnected)
            {
                @* Only shown on narrow screens; on desktop the details are always visible. *@
                <button class="link-btn narrow-toggle" @onclick="() => _showAccountDetails = !_showAccountDetails"
                        aria-expanded="@(_showAccountDetails ? "true" : "false")">
                    @(_showAccountDetails ? "Hide details ▴" : "Details ▾")
                </button>
            }
        </div>

        @if (_status.MissingScopes.Count > 0)
        {
            <div class="alert" style="margin-top:.75rem">
                Missing permission(s): @foreach (var sc in _status.MissingScopes) { <span class="badge err scope">@sc</span> } Click <strong>Reconnect</strong> to grant them.
            </div>
        }

        @if (_status.Status != AccountStatus.Disconnected)
        {
            <dl class="kv collapsible @(_showAccountDetails ? "" : "collapsed")">
                <dt>Connected</dt><dd>@Format.Local(_status.ConnectedAt)</dd>
                <dt>Access token expires</dt><dd>@Format.Local(_status.ExpiresAt)</dd>
                <dt>Scopes</dt>
                <dd class="pills">
                    @foreach (var sc in (_status.Scope ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="badge none scope">@sc</span>
                    }
                </dd>
                @if (!string.IsNullOrEmpty(_status.LastError))
                {
                    <dt>Last error</dt><dd>@_status.LastError</dd>
                }
            </dl>
        }

        <div class="row actions">
            @if (_status.Status == AccountStatus.Connected)
            {
                <button @onclick="TestAsync" disabled="@_busy">Test</button>
                <button @onclick="Connect" disabled="@_busy">Reconnect</button>
                <button @onclick="DisconnectAsync" disabled="@_busy">Disconnect</button>
            }
            else
            {
                <button class="primary" @onclick="Connect">Connect Yoto account</button>
            }
        </div>

        @if (_test is not null)
        {
            <p class="@(_test.Ok ? "" : "alert")" style="margin-top:.75rem">@_test.Message</p>
            @if (_test.Playlists.Count > 0)
            {
                <ul class="plain">
                    @foreach (var p in _test.Playlists.OrderByDescending(p => p.UpdatedAt))
                    {
                        <li><CardLink CardId="@p.CardId" Title="@p.Title" /> <span class="muted">— updated @Format.Local(p.UpdatedAt)</span></li>
                    }
                </ul>
            }
        }
    }
</section>

<section class="card">
    <div class="row card-head">
        <h2>Playlists</h2>
        <a class="button" href="/playlists/new">New playlist</a>
    </div>
    @if (_playlists is null)
    {
        <p class="muted">Loading…</p>
    }
    else if (_playlists.Count == 0)
    {
        <p class="muted">No playlists yet.</p>
    }
    else
    {
        <div class="subs">
            @foreach (var p in _playlists)
            {
                <div class="sub">
                    @if (p.CoverUrl is not null) { <img src="@p.CoverUrl" alt="" /> }
                    <div class="grow">
                        <div><a class="stretch" href="/playlists/@p.Id"><strong>@p.Name</strong></a></div>
                        <div class="muted">@PodcastsText(p)</div>
                        <div class="muted">@p.EpisodeCount episodes · @p.FavouriteCount favourites · synced @Format.Ago(p.LastSyncedAt, Time.GetUtcNow()) · next @NextText(p.Id)
                            @if (p.YotoCardId is not null) { <span> · </span><CardLink CardId="@p.YotoCardId" Title="Yoto" /> }
                        </div>
                    </div>
                    @if (!p.Enabled) { <span class="badge none">Disabled</span> }
                    else if (p.AnyError is not null) { <span class="badge err" title="@p.AnyError">Error</span> }
                    else { <span class="badge ok">OK</span> }
                </div>
            }
        </div>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "authError")]
    public string? AuthError { get; set; }

    private YotoAccountStatus? _status;
    private YotoConnectionTest? _test;
    private bool _busy;
    private bool _showAccountDetails;
    private IReadOnlyList<PlaylistSummary>? _playlists;

    protected override async Task OnInitializedAsync()
    {
        _status = await Account.GetStatusAsync();
        _playlists = await Playlists.ListAsync();
        foreach (var p in _playlists) _next[p.Id] = await Scheduler.GetNextSyncAsync(p.Id);
    }

    private readonly Dictionary<int, NextSync> _next = new();

    private string NextText(int id) =>
        !_next.TryGetValue(id, out var n) ? "—"
        : n.PausedReason is not null ? n.PausedReason.ToLowerInvariant()
        : Format.Until(n.At, Time.GetUtcNow());

    private static string PodcastsText(PlaylistSummary p) => p.Podcasts.Count switch
    {
        0 => "No podcasts",
        1 => p.Podcasts[0].Name,
        _ => $"{p.Podcasts.Count} podcasts: {string.Join(", ", p.Podcasts.Select(x => x.Enabled ? x.Name : $"{x.Name} (off)"))}",
    };

    // Full page load: /auth/login is a server endpoint, not a Blazor route.
    private void Connect() => Nav.NavigateTo("/auth/login", forceLoad: true);

    private async Task TestAsync()
    {
        _busy = true;
        try
        {
            _test = await Account.TestConnectionAsync();
            _status = await Account.GetStatusAsync(); // refresh may have rotated tokens / flagged re-auth
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DisconnectAsync()
    {
        _busy = true;
        try
        {
            await Account.DisconnectAsync();
            _test = null;
            _status = await Account.GetStatusAsync();
        }
        finally
        {
            _busy = false;
        }
    }

}
