@page "/playlists/{PlaylistId:int}/podcasts/new"
@using PodcastToYoto.Feeds
@inject PlaylistService Playlists
@inject SubscriptionService Subscriptions
@inject NavigationManager Nav
@inject SubscriptionNotices Notices

<PageTitle>Add podcast · Podcast → Yoto</PageTitle>

@if (_playlist is null)
{
    <p class="muted">@(_notFound ? "Playlist not found." : "Loading…")</p>
}
else
{
    <h1 style="font-size:1.2rem">Add a podcast to <a href="/playlists/@PlaylistId">@_playlist.Name</a></h1>

    <FeedChooser Heading="1. Podcast" Exclude="_existing" OnPreviewed="OnPreviewed" />

    @if (_feed is not null)
    {
        <section class="card">
            <h2>2. Settings</h2>
            @if (_existing.Contains(_settings.FeedUrl))
            {
                <div class="alert">This podcast is already in the playlist.</div>
            }
            <SubscriptionSettingsForm Model="_settings" OnValidSubmit="AddAsync" SubmitLabel="Add podcast" Busy="_busy" LockFeedUrl="true" />
            @if (_error is not null) { <div class="alert">@_error</div> }
        </section>
    }
}

@code {
    [Parameter] public int PlaylistId { get; set; }

    private Playlist? _playlist;
    private bool _notFound;
    private HashSet<string> _existing = [];
    private PodcastFeed? _feed;
    private SubscriptionSettings _settings = new();
    private string? _error;
    private bool _busy;

    protected override async Task OnParametersSetAsync()
    {
        _playlist = await Playlists.GetAsync(PlaylistId);
        _notFound = _playlist is null;
        _existing = _playlist?.Subscriptions.Select(s => s.FeedUrl).ToHashSet(StringComparer.Ordinal) ?? [];
    }

    private void OnPreviewed((string Url, PodcastFeed? Feed) e)
    {
        _feed = e.Feed;
        if (e.Feed is not null) _settings = new SubscriptionSettings { Name = e.Feed.Title, FeedUrl = e.Url };
    }

    private async Task AddAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var (_, poll) = await Subscriptions.AddAsync(PlaylistId, _settings);
            Notices.Set(PlaylistId, $"Added {_settings.Name}. {poll.Describe()} It's published on the next sync.");
            Nav.NavigateTo($"/playlists/{PlaylistId}");
        }
        catch (Exception ex)
        {
            _error = $"Couldn't add podcast: {ex.Message}";
            _busy = false;
        }
    }
}
