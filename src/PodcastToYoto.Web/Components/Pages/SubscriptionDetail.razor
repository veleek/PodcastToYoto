@page "/playlists/{PlaylistId:int}/podcasts/{Id:int}"
@page "/subscriptions/{Id:int}"
@implements IDisposable
@using PodcastToYoto.Web.Icons
@inject PlaylistService Playlists
@inject SubscriptionService Subscriptions
@inject IconCatalog Icons
@inject SyncActivity Activity
@inject NavigationManager Nav
@inject TimeProvider Time

<PageTitle>@(_sub?.Name ?? "Podcast") · Podcast → Yoto</PageTitle>

@if (_notFound)
{
    <section class="card"><h2>Not found</h2><p><a href="/">Back to dashboard</a></p></section>
}
else if (_sub is null)
{
    <p class="muted">Loading…</p>
}
else
{
    <section class="card">
        @* Grid: cover | title on top, details below. On narrow screens the details span the full width. *@
        <div class="sub-hero @(_sub.CoverSourceUrl is null ? "no-cover" : "")">
            @if (_sub.CoverSourceUrl is not null)
            {
                <img class="hero-img" src="@_sub.CoverSourceUrl" alt="" />
            }
            <div class="hero-title">
                <h2>@_sub.Name</h2>
                <div class="muted" style="overflow-wrap:anywhere">@_sub.FeedUrl</div>
            </div>
            <div class="hero-body">
                <dl class="kv">
                    <dt>Playlist</dt>
                    <dd>
                        <a href="/playlists/@_playlist!.Id">@_playlist.Name</a>
                        @if (!_sub.Enabled) { <span class="badge after none">Not included</span> }
                    </dd>
                    <dt>Episodes</dt>
                    <dd>@_sub.Episodes.Count total · @_sub.Episodes.Count(e => e.IsFavourite) favourites · @_positions.Count on playlist · @_sub.Episodes.Count(e => e.AudioId is not null) uploaded</dd>
                    <dt>Feed checked</dt>
                    <dd>@Format.Ago(_sub.LastPolledAt, Time.GetUtcNow())</dd>
                    @if (_sub.LastError is not null)
                    {
                        <dt>Error</dt><dd class="err-text">@_sub.LastError</dd>
                    }
                </dl>
                <div class="row">
                    <a class="button" href="/playlists/@_playlist.Id">Back to playlist</a>
                    <button @onclick="PollAsync" disabled="@(_busy || _activity is not null)">Check feed</button>
                    <button @onclick="() => _editing = !_editing">@(_editing ? "Close settings" : "Settings")</button>
                </div>
                @if (_activity is not null)
                {
                    <div class="toast"><span class="spinner"></span> Playlist sync: @_activity</div>
                }
                else if (_message is not null)
                {
                    <div class="toast">@_message</div>
                }
            </div>
        </div>
    </section>

    @if (_editing)
    {
        <section class="card">
            <h2>Podcast settings</h2>
            <SubscriptionSettingsForm Model="_settings" OnValidSubmit="SaveAsync" Busy="_busy" HasLogoIcon="@(_sub.LogoIconMediaId is not null)">
                @if (_confirmDelete)
                {
                    <button type="button" class="danger" @onclick="DeleteAsync">Really remove?</button>
                    <button type="button" @onclick="() => _confirmDelete = false">Cancel</button>
                }
                else
                {
                    <button type="button" class="danger" @onclick="() => _confirmDelete = true">Remove from playlist</button>
                }
            </SubscriptionSettingsForm>
            <p class="muted">Removing forgets this podcast's episodes and favourites here; its tracks leave the Yoto playlist on the next sync. To keep it but stop publishing it, untick "Included in the playlist".</p>
        </section>

        <LogoIconPanel Podcast="_sub" OnChanged="LoadAsync" />
    }

    <section class="card">
        <div class="row card-head">
            <h2>Episodes</h2>
            <div class="row">
                <input class="text filter" placeholder="Filter…" @bind="_filter" @bind:event="oninput" />
                <label class="row"><input type="checkbox" @bind="_favouritesOnly" /> Favourites</label>
                <label class="row"><input type="checkbox" @bind="_plannedOnly" /> On playlist</label>
                @if (_confirmClearFavs)
                {
                    <button class="danger" @onclick="ClearFavouritesAsync">Clear all favourites?</button>
                    <button @onclick="() => _confirmClearFavs = false">Cancel</button>
                }
                else if (_sub.Episodes.Any(e => e.IsFavourite))
                {
                    <button @onclick="() => _confirmClearFavs = true">Clear favourites</button>
                }
            </div>
        </div>
        <p class="muted">
            On the playlist: @_positions.Count episodes (@_sub.RecentCount most recent + favourites, at most @_sub.MaxTracks). # is the position in the whole playlist.
            @foreach (var w in _plan!.Warnings) { <span class="err-text"> @w</span> }
            @if (!_sub.UseDefaultIcon && _iconIndex is null && Icons.LastError is not null) { <span class="err-text"> @Icons.LastError</span> }
        </p>
        <div class="table-wrap">
        <table class="eps">
            <thead>
                <tr><th></th><th title="Position on the playlist">#</th><th title="Icon on the player">Icon</th><th class="wide-only">Published</th><th>Title</th><th class="wide-only">Length</th><th class="wide-only" title="Uploaded to Yoto">Up</th></tr>
            </thead>
            <tbody>
                @foreach (var e in VisibleEpisodes)
                {
                    var pos = _positions.TryGetValue(e.Id, out var p) ? p : (int?)null;
                    <tr class="@(e.MissingFromFeedSince is null ? "" : "missing") @(pos is null ? "" : "planned")" @key="e.Id">
                        <td>
                            <button class="star @(e.IsFavourite ? "on" : "")" title="@(e.IsFavourite ? "Unpin" : "Pin as favourite")"
                                    @onclick="() => ToggleFavouriteAsync(e)">@(e.IsFavourite ? "★" : "☆")</button>
                        </td>
                        <td class="num">@pos</td>
                        <td>
                            @{ var shown = EpisodeIcons.Describe(e, _sub, _iconIndex, _iconMatches.GetValueOrDefault(e.Id)); }
                            @if (_iconIndex is not null)
                            {
                                <button class="icon-btn @(e.IconMediaId is null ? "" : "pinned")" title="@shown.Tip · click to change" @onclick="() => _iconFor = e">
                                    @if (shown.Url is { } url) { <img class="icon16" src="@url" alt="@shown.Title" /> } else { <span>+</span> }
                                </button>
                            }
                            else if (shown.Url is { } url)
                            {
                                <img class="icon16" src="@url" alt="@shown.Title" title="@shown.Tip" />
                            }
                        </td>
                        <td class="num wide-only">@Format.Date(e.PublishedAt)</td>
                        <td class="title">
                            @e.Title
                            @if (e.EpisodeType is "bonus" or "trailer") { <span class="badge after none">@e.EpisodeType</span> }
                            @if (e.MissingFromFeedSince is not null) { <span class="badge after warn" title="Since @Format.Local(e.MissingFromFeedSince)">not in feed</span> }
                            <div class="narrow-only muted meta">@Format.Date(e.PublishedAt) · @Format.Duration(e.DurationSeconds)@(e.AudioId is null ? "" : " · ✓ uploaded")</div>
                        </td>
                        <td class="num wide-only">@Format.Duration(e.DurationSeconds)</td>
                        <td class="wide-only">@(e.AudioId is null ? "" : "✓")</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </section>
}

@if (_iconFor is not null && _iconIndex is not null)
{
    <IconPicker Index="_iconIndex" EpisodeTitle="@_iconFor.Title" CurrentMediaId="@_iconFor.IconMediaId"
                AutoMatch="@_iconMatches.GetValueOrDefault(_iconFor.Id)"
                OnPick="PickIconAsync" OnClose="() => _iconFor = null" />
}

@code {
    [Parameter] public int PlaylistId { get; set; }
    [Parameter] public int Id { get; set; }

    private Playlist? _playlist;
    private Subscription? _sub;
    private PlannedPlaylist? _plan;
    private Dictionary<int, IconMatch?> _iconMatches = new();
    private IconIndex? _iconIndex;
    private Episode? _iconFor;
    private Dictionary<int, int> _positions = new();
    private SubscriptionSettings _settings = new();
    private bool _notFound, _busy, _editing, _confirmDelete, _favouritesOnly, _plannedOnly;
    private bool _confirmClearFavs;
    private string _filter = "";
    private string? _message, _activity;

    private IEnumerable<Episode> VisibleEpisodes => _sub!.Episodes
        .Where(e => !_favouritesOnly || e.IsFavourite)
        .Where(e => !_plannedOnly || _positions.ContainsKey(e.Id))
        .Where(e => string.IsNullOrWhiteSpace(_filter) || e.Title.Contains(_filter, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized() => Activity.Changed += OnActivityChanged;

    public void Dispose() => Activity.Changed -= OnActivityChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (PlaylistId == 0)
        {
            // Old /subscriptions/{id} link (from before playlists held several podcasts).
            var playlistId = await Subscriptions.GetPlaylistIdAsync(Id);
            if (playlistId is null) { _notFound = true; return; }
            Nav.NavigateTo($"/playlists/{playlistId}/podcasts/{Id}", replace: true);
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _playlist = await Playlists.GetAsync(PlaylistId);
        _sub = _playlist?.Subscriptions.SingleOrDefault(s => s.Id == Id);
        _notFound = _sub is null;
        if (_sub is null) return;
        _activity = Activity.Get(PlaylistId);

        _settings = SubscriptionSettings.From(_sub);

        IconIndex? icons = null;
        try
        {
            icons = await Icons.GetAsync(); // also needed for the picker, even with automatic icons off
        }
        catch (PodcastToYoto.Yoto.YotoAuthException)
        {
            // Not connected / needs re-login: the dashboard says so; just show no icons here.
        }
        _iconIndex = icons;
        _iconMatches = _sub.Episodes.ToDictionary(e => e.Id, e => EpisodeIcons.Match(e, _sub, icons));
        Replan();
    }

    /// <summary>Positions are in the whole playlist, so this podcast's episodes show where they land among the others.</summary>
    private void Replan()
    {
        _plan = PlaylistPlanner.Plan(_playlist!, _playlist!.Subscriptions);
        _positions = _plan.Episodes.Select((e, i) => (e, i + 1)).Where(x => x.e.SubscriptionId == Id).ToDictionary(x => x.e.Id, x => x.Item2);
    }

    private void OnActivityChanged(int playlistId)
    {
        if (playlistId != PlaylistId) return;
        _ = InvokeAsync(async () =>
        {
            var was = _activity;
            _activity = Activity.Get(PlaylistId);
            if (_activity is null && was is not null) await LoadAsync(); // sync finished: refresh everything
            StateHasChanged();
        });
    }

    private async Task PollAsync()
    {
        _busy = true;
        try
        {
            var outcome = await Subscriptions.PollAsync(Id);
            _message = outcome.Describe();
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            await Subscriptions.UpdateSettingsAsync(Id, _settings);
            _message = "Settings saved. They apply on the next sync.";
            _editing = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _message = $"Save failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ClearFavouritesAsync()
    {
        var n = await Subscriptions.ClearFavouritesAsync(Id);
        _confirmClearFavs = false;
        _message = $"Cleared {n} favourite(s). Applies on the next sync.";
        await LoadAsync();
    }

    private async Task PickIconAsync(string? mediaId)
    {
        var e = _iconFor!;
        _iconFor = null;
        await Subscriptions.SetIconAsync(e.Id, mediaId);
        e.IconMediaId = mediaId;
        _message = mediaId is null
            ? $"“{e.Title}” is back to its automatic icon. Applies on the next sync."
            : $"Icon set for “{e.Title}”. Applies on the next sync.";
    }

    private async Task DeleteAsync()
    {
        await Subscriptions.DeleteAsync(Id);
        Nav.NavigateTo($"/playlists/{PlaylistId}");
    }

    private async Task ToggleFavouriteAsync(Episode e)
    {
        var value = !e.IsFavourite;
        e.IsFavourite = value; // optimistic
        Replan();
        try
        {
            await Subscriptions.SetFavouriteAsync(e.Id, value);
        }
        catch (Exception ex)
        {
            e.IsFavourite = !value;
            Replan();
            _message = $"Couldn't update favourite: {ex.Message}";
        }
    }
}
