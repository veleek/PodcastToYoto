<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="icon" href="@Assets["favicon.ico"]" sizes="32x32" />
    <link rel="icon" href="@Assets["favicon.svg"]" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="@Assets["apple-touch-icon.png"]" />
    <title>Podcast → Yoto</title>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <div id="blazor-error-ui">
        Something went wrong. <a href="" class="reload">Reload</a>
        <span class="dismiss">✕</span>
    </div>
    @* autostart="false": reconnect.js starts Blazor with an SSO-aware reconnect policy. *@
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script src="@Assets["reconnect.js"]"></script>
</body>
</html>
