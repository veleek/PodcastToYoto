@using PodcastToYoto.Web.Icons
@using PodcastToYoto.Yoto
@inject YotoApiClient Yoto
@inject YotoIconsLibrary YotoIcons

@* Pick a podcast's logo icon: one of the account's custom icons, one of Yoto's own, or one from yotoicons.com. *@
<div class="modal-backdrop" @onclick="OnClose">
    <div class="modal card" role="dialog" aria-label="Choose podcast icon" @onclick:stopPropagation="true">
        <div class="row card-head">
            <h2>Icon for @PodcastName</h2>
            <button class="close" title="Close" @onclick="OnClose">✕</button>
        </div>

        <div class="row tabs">
            <button class="@(_tab == Tab.Mine ? "on" : "")" @onclick="() => _tab = Tab.Mine">Your icons</button>
            <button class="@(_tab == Tab.Yoto ? "on" : "")" @onclick="() => _tab = Tab.Yoto">Icon Library</button>
            <button class="@(_tab == Tab.YotoIcons ? "on" : "")" title="Search yotoicons.com" @onclick="() => _tab = Tab.YotoIcons">Search</button>
            @if (_busy) { <span class="muted"><span class="spinner"></span> Uploading to Yoto…</span> }
        </div>
        @if (_pickError is not null) { <div class="alert">@_pickError</div> }

        @if (_tab == Tab.Yoto && _index is not null)
        {
            <div class="row lib-filter">
                <input class="text grow" placeholder="Search icons (e.g. tree, hat, train)…" @bind="_query" @bind:event="oninput" />
                <label class="check" title="Include icons cached from yotoicons.com searches"><input type="checkbox" @bind="ShowYotoIcons" /> yotoicons.com</label>
            </div>
        }

        @* The yotoicons.com search scrolls its own results, so its search box stays put. *@
        <div class="@(_tab == Tab.YotoIcons ? "" : "icon-scroll")">
            @if (_tab == Tab.YotoIcons)
            {
                <YotoIconsSearch InitialQuery="@_query" SelectedMediaId="@CurrentMediaId" OnPick="ChooseAsync" OnCacheChanged="() => _index = Index is null ? null : YotoIcons.Extend(Index)" />
            }
            else if (_tab == Tab.Mine)
            {
                @if (_mine is null && _error is null)
                {
                    <p class="muted"><span class="spinner"></span> Loading your icons…</p>
                }
                else if (_error is not null)
                {
                    <div class="alert">@_error</div>
                }
                else if (_mine!.Count == 0)
                {
                    <p class="muted">No custom icons on your Yoto account yet.</p>
                }
                else
                {
                    @Grid(_mine)
                }
            }
            else if (_index is null)
            {
                <p class="muted">Yoto's icon library isn't loaded (connect Yoto first).</p>
            }
            else
            {
                @if (string.IsNullOrWhiteSpace(_query))
                {
                    @foreach (var group in Browse!.Groups)
                    {
                        <h3 class="icon-group">@group.Name <span class="muted">(@group.Icons.Count)</span></h3>
                        @Grid(group.Icons)
                    }
                }
                else
                {
                    var results = Browse!.Search(_query, int.MaxValue);
                    @if (results.Count == 0)
                    {
                        <p class="muted">No icons match “@_query”. Try Search to look on yotoicons.com.</p>
                    }
                    else
                    {
                        @Grid(results)
                    }
                }
            }
        </div>
    </div>
</div>

@code {
    /// <summary>What the Icon Library tab shows: with or without the cached yotoicons.com icons.</summary>
    private IconIndex? Browse => YotoIcons.ShowInLibrary ? _index : _index?.WithoutExtras;

    private bool ShowYotoIcons
    {
        get => YotoIcons.ShowInLibrary;
        set => YotoIcons.ShowInLibrary = value;
    }

    [Parameter, EditorRequired] public string PodcastName { get; set; } = "";
    [Parameter] public IconIndex? Index { get; set; }
    [Parameter] public string? CurrentMediaId { get; set; }

    /// <summary>Raised with the chosen icon.</summary>
    [Parameter] public EventCallback<IconCandidate> OnChoose { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private enum Tab { Mine, Yoto, YotoIcons }

    private Tab _tab = Tab.Mine;
    private string _query = "";
    private IReadOnlyList<IconCandidate>? _mine;
    private string? _error, _pickError;
    private IconIndex? _index;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _index = Index is null ? null : YotoIcons.Extend(Index);
        try
        {
            _mine = (await Yoto.GetUserIconsAsync())
                .Select(i => new IconCandidate(i.MediaId, i.Title, i.Url, i.Tags))
                .ToList();
        }
        catch (Exception ex)
        {
            _error = ex is YotoApiException { StatusCode: 403 }
                ? "Yoto refused to list your icons (needs the user:icons:manage scope). Reconnect Yoto on the dashboard."
                : $"Couldn't load your icons: {ex.Message}";
        }
    }

    private RenderFragment Grid(IReadOnlyList<IconCandidate> icons) => __builder =>
    {
        <IconGrid Icons="icons" SelectedMediaId="@CurrentMediaId" OnPick="ChooseAsync" />
    };

    /// <summary>yotoicons.com icons are uploaded to the Yoto account the first time they're chosen.</summary>
    private async Task ChooseAsync(IconCandidate icon)
    {
        if (_busy) return;
        _busy = true;
        _pickError = null;
        try
        {
            icon = await YotoIcons.EnsureOnYotoAsync(icon);
        }
        catch (Exception ex)
        {
            _pickError = ex is YotoApiException { StatusCode: 403 }
                ? "Yoto refused the upload (needs the user:icons:manage scope). Reconnect Yoto on the dashboard."
                : $"Couldn't upload that icon to Yoto: {ex.Message}";
            return;
        }
        finally
        {
            _busy = false;
        }
        await OnChoose.InvokeAsync(icon);
    }
}
