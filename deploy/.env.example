# Image to run: local tag, or <registry-host>:<port>/podcast-to-yoto:<tag> if pulling from a registry.
IMAGE=podcast-to-yoto:latest
# Public host name (Traefik router rule + OAuth redirect URI https://<host>/auth/callback).
YOTO_HOST=yoto.example.com
YOTO_CLIENT_ID=
TZ=America/Los_Angeles
# Home Assistant notifications (optional; see README). Leave HA_BASE_URL empty to turn them off.
HA_BASE_URL=
HA_WEBHOOK_ID=
